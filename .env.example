# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- database -----------------------------------------------------------
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me
POSTGRES_USER=pantry
POSTGRES_DB=pantry

# --- app ----------------------------------------------------------------
APP_PORT=8080
SESSION_TTL_DAYS=30

# Set both to true only when something terminates TLS in front of the app
# (a Tailscale serve, Caddy, or nginx). On plain HTTP over the LAN, a secure
# cookie is never sent and nobody can sign in.
COOKIE_SECURE=false
TRUST_PROXY=false

# --- photo scanning (optional) ------------------------------------------
# Without a key, barcode scanning and everything else still work; the photo
# scanner reports itself as unavailable. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5

# --- barcode lookup -----------------------------------------------------
# Open Food Facts asks that clients identify themselves. An email helps them
# reach you if a client misbehaves; it is sent to them and nowhere else.
OFF_USER_AGENT=Pantry/0.1 (self-hosted household inventory)

# --- local development only ---------------------------------------------
# Used by `pnpm dev` outside Docker, and by the integration tests.
DATABASE_URL=postgres://pantry:pantry@127.0.0.1:5432/pantry
TEST_DATABASE_URL=postgres://pantry:pantry@127.0.0.1:5432/pantry_test
