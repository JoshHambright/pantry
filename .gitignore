.DS_Store
.vscode/
.idea/

# Database dumps. The directory itself is tracked so the bind mount in
# docker-compose.yml finds a directory owned by whoever cloned the repo —
# otherwise Docker creates it as root and the backup command in DEPLOY.md,
# which redirects on the host, cannot write to it.
backups/*
!backups/.gitkeep

